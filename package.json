{
  "name": "luminar",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "description": "星星脱敏 · 本地离线法律文书脱敏工具",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "app:build:mac": "tauri build --target aarch64-apple-darwin",
    "app:build:win": "tauri build --target x86_64-pc-windows-msvc",
    "test:ui": "npm run build && node scripts/ui_smoke.mjs",
    "test:rust": "cd src-tauri && cargo test",
    "app:build:universal": "tauri build --target universal-apple-darwin"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/myleemartin/luminar.git"
  },
  "homepage": "https://github.com/myleemartin/luminar",
  "bugs": {
    "url": "https://github.com/myleemartin/luminar/issues"
  },
  "keywords": [
    "tauri",
    "rust",
    "redaction",
    "privacy",
    "legal-tech",
    "offline",
    "ocr"
  ]
}
